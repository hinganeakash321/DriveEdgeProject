# ============================================================
# DriveEdge environment configuration (example)
# Copy to .env and fill in values. Never commit real secrets.
# ============================================================

APP_ENV=development

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database (Docker Compose defaults below)
DATABASE_URL=postgresql+psycopg://driveedge:driveedge@localhost:5432/driveedge

# ------------------------------------------------------------
# Claude / Anthropic
# Option A (plain API key): set ANTHROPIC_API_KEY.
# Option B (corporate gateway, e.g. devbar): set ANTHROPIC_BASE_URL,
#   ANTHROPIC_API_KEY_HELPER (command that prints a token), and
#   ANTHROPIC_CA_CERT (path to CA bundle). Leave ANTHROPIC_API_KEY empty.
# If neither is configured, AI features degrade gracefully and the rest
# of the app keeps working.
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY_HELPER=
ANTHROPIC_CA_CERT=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=2048
# Some gateway-hosted models only accept temperature=1 (determinism is enforced in Python).
CLAUDE_TEMPERATURE=1.0

# ------------------------------------------------------------
# Multi-agent AI controls (safe defaults; all optional)
# ------------------------------------------------------------
AI_MAX_TOOL_CALLS=8
AI_RECURSION_LIMIT=12
AI_REQUEST_TIMEOUT_SECONDS=30
AI_ENABLE_MEMORY=true

# Email (Mailpit local SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=notifications@driveedge.local

# Auth
AUTH_SECRET=replace-with-a-secure-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
